{
 "doctype": "DocType",
 "name": "Cash Bank Voucher",
 "module": "Trust Operations",
 "custom": 0,
 "engine": "InnoDB",
 "editable_grid": 1,
 "track_changes": 1,
 "sort_field": "modified",
 "sort_order": "DESC",
 "fields": [
  {
   "fieldname": "company",
   "fieldtype": "Link",
   "label": "Company",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "options": "Company"
  },
  {
   "fieldname": "voucher_type",
   "fieldtype": "Select",
   "label": "Voucher Type",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "options": "Receipt\nPayment"
  },
  {
   "fieldname": "posting_date",
   "fieldtype": "Date",
   "label": "Posting Date",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "default": "Today"
  },
  {
   "fieldname": "mode",
   "fieldtype": "Select",
   "label": "Mode",
   "reqd": 1,
   "in_list_view": 1,
   "options": "Cash\nBank",
   "default": "Cash"
  },
  {
   "fieldname": "bank_account",
   "fieldtype": "Link",
   "label": "Bank Account",
   "options": "Bank Account",
   "depends_on": "eval:doc.mode=='Bank'",
   "mandatory_depends_on": "eval:doc.mode=='Bank'"
  },
  {
   "fieldname": "account_head",
   "fieldtype": "Link",
   "label": "Account Head",
   "reqd": 1,
   "in_list_view": 1,
   "options": "Account",
   "description": "Income, expense or trust account of that Company"
  },
  {
   "fieldname": "amount",
   "fieldtype": "Currency",
   "label": "Amount",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "sb_p",
   "fieldtype": "Section Break",
   "label": "Party"
  },
  {
   "fieldname": "party_type",
   "fieldtype": "Select",
   "label": "Party Type",
   "options": "\nSupplier\nEmployee"
  },
  {
   "fieldname": "party",
   "fieldtype": "Dynamic Link",
   "label": "Party",
   "options": "party_type",
   "description": "Only for party accounts"
  },
  {
   "fieldname": "sb_n",
   "fieldtype": "Section Break",
   "label": "Details"
  },
  {
   "fieldname": "narration",
   "fieldtype": "Small Text",
   "label": "Narration"
  },
  {
   "fieldname": "reference_no",
   "fieldtype": "Data",
   "label": "Reference No",
   "description": "Cheque number or UTR"
  },
  {
   "fieldname": "paper_book",
   "fieldtype": "Data",
   "label": "Paper Book"
  },
  {
   "fieldname": "paper_no",
   "fieldtype": "Int",
   "label": "Paper No",
   "description": "Paper receipt number"
  },
  {
   "fieldname": "journal_entry",
   "fieldtype": "Link",
   "label": "Journal Entry",
   "read_only": 1,
   "options": "Journal Entry",
   "no_copy": 1
  },
  {
   "fieldname": "amended_from",
   "fieldtype": "Link",
   "label": "Amended From",
   "options": "Cash Bank Voucher",
   "no_copy": 1,
   "print_hide": 1,
   "read_only": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "permlevel": 0,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1
  },
  {
   "role": "Principal",
   "read": 1,
   "permlevel": 0,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1
  },
  {
   "role": "Data Entry",
   "read": 1,
   "permlevel": 0
  },
  {
   "role": "Data Entry",
   "read": 1,
   "permlevel": 0,
   "write": 1,
   "create": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "if_owner": 1
  }
 ],
 "field_order": [
  "company",
  "voucher_type",
  "posting_date",
  "mode",
  "bank_account",
  "account_head",
  "amount",
  "sb_p",
  "party_type",
  "party",
  "sb_n",
  "narration",
  "reference_no",
  "paper_book",
  "paper_no",
  "journal_entry",
  "amended_from"
 ],
 "is_submittable": 1,
 "autoname": "CBV-.YYYY.-.#####",
 "naming_rule": "Expression (old style)",
 "search_fields": "company,voucher_type,account_head"
}
