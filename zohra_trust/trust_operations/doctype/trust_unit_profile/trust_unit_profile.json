   "label": "Tracks Residents",
   "description": "Turns on students, enrollments and Boarding Attendance"
  },
  {
   "fieldname": "tracks_food_statement",
   "fieldtype": "Check",
   "label": "Tracks Food Statement",
   "description": "Turns on the Food Expenditure Statement"
  },
  {
   "fieldname": "tracks_results",
   "fieldtype": "Check",
   "label": "Tracks Results",
   "description": "Turns on the Result Sheet of Inmates"
