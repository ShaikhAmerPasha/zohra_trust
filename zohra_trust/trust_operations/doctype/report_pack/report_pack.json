{
 "doctype": "DocType",
 "name": "Report Pack",
 "module": "Trust Operations",
 "custom": 0,
 "engine": "InnoDB",
 "editable_grid": 1,
 "track_changes": 1,
 "sort_field": "modified",
 "sort_order": "DESC",
 "autoname": "RPK-.YYYY.-.#####",
 "naming_rule": "Expression (old style)",
 "search_fields": "company,from_date,to_date",
 "fields": [
  {
   "fieldname": "company",
   "fieldtype": "Link",
   "label": "Company",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "options": "Company"
  },
  {
   "fieldname": "from_date",
   "fieldtype": "Date",
   "label": "From Date",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "to_date",
   "fieldtype": "Date",
   "label": "To Date",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "sb_pages",
   "fieldtype": "Section Break",
   "label": "Pages, in filing order"
  },
  {
   "fieldname": "pages",
   "fieldtype": "Table",
   "label": "Pages",
   "options": "Report Pack Page",
   "description": "Drag rows to change the order. The Grant Bill is not part of the pack yet: its format is still to come from Zohra"
  }
 ],
 "field_order": [
  "company",
  "from_date",
  "to_date",
  "sb_pages",
  "pages"
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "print": 1,
   "export": 1,
   "share": 1
  },
  {
   "role": "Principal",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "print": 1,
   "share": 1
  }
 ]
}
